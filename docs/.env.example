# ═══════════════════════════════════════════════════════════════════
#  Ummati Perfumes — Environment Variables
#  Copy this file to .env.local and fill in your real values.
#  NEVER commit .env.local to version control.
#  NEVER expose *_SECRET or *_KEY_SECRET variables to the browser.
# ═══════════════════════════════════════════════════════════════════

# ── SITE CONFIGURATION ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ummatiperfumes.com
# Full URL of the site — used for OG tags, canonical URLs, email links
# In development: http://localhost:3000

NEXT_PUBLIC_SITE_NAME=Ummati Perfumes
# Displayed in browser tab, OG tags, structured data

# ── MONGODB ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ummati_perfumes?retryWrites=true&w=majority
# MongoDB Atlas connection string
# For production: use Atlas M10+ cluster for guaranteed performance
# Never use M0 (free tier) for production

# ── REDIS (UPSTASH) ─────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://<your-region>.upstash.io
# Upstash Redis REST endpoint
# Get from: https://console.upstash.com

UPSTASH_REDIS_REST_TOKEN=AX...
# Upstash Redis REST token (keep secret — server-side only)

# ── RAZORPAY ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Razorpay Key ID — server-side use (order creation, signature verification)
# Test: rzp_test_... | Production: rzp_live_...

RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Razorpay Key Secret — NEVER expose to browser
# Used for: creating orders, verifying payment signatures (HMAC-SHA256)

RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx
# Razorpay Webhook Signing Secret
# Set in Razorpay Dashboard → Webhooks → your webhook → secret
# Used to verify X-Razorpay-Signature on incoming webhooks

NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Same as RAZORPAY_KEY_ID but exposed to browser (needed to open Razorpay modal)
# This is safe to expose — it's a public key, not the secret

# ── CLOUDINARY ──────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
# Your Cloudinary cloud name — visible in dashboard

CLOUDINARY_API_KEY=000000000000000
# Cloudinary API key — server-side product image uploads

CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxx
# Cloudinary API secret — NEVER expose to browser

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
# Same as CLOUDINARY_CLOUD_NAME but for browser-side image URL construction

# ── AWS S3 (OPTIONAL — RAW IMAGE BACKUP) ────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
# AWS access key — only needed if using S3 for raw asset backup

AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
# AWS secret key — NEVER expose to browser

AWS_REGION=ap-south-1
# AWS region — ap-south-1 (Mumbai) recommended for Indian users

AWS_S3_BUCKET_NAME=ummati-perfumes-assets
# S3 bucket name for raw product image storage

# ── RESEND (TRANSACTIONAL EMAIL) ─────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Resend API key — server-side only
# Used for: order confirmation emails, shipping updates
# Get from: https://resend.com

RESEND_FROM_EMAIL=orders@ummatiperfumes.com
# Sender email address — must be verified in Resend dashboard

# ── MSG91 (SMS / OTP) ────────────────────────────────────────────────
MSG91_AUTH_KEY=xxxxxxxxxxxxxxxxxxxx
# MSG91 authentication key — server-side only
# Used for: OTP delivery, order SMS notifications
# Get from: https://msg91.com

MSG91_OTP_TEMPLATE_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# Template ID for OTP SMS (must be registered in MSG91 DLT)
# Required for Indian SMS delivery

MSG91_SENDER_ID=UMMATI
# 6-character sender ID (must be registered with TRAI/DLT for India)

MSG91_ORDER_TEMPLATE_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# Template ID for order confirmation SMS

# ── AUTHENTICATION (JWT) ─────────────────────────────────────────────
JWT_SECRET=a-very-long-random-string-at-least-64-characters-replace-this-now
# JWT signing secret — NEVER expose to browser, NEVER share
# Generate: openssl rand -hex 64

ADMIN_JWT_SECRET=another-very-long-random-string-different-from-jwt-secret
# Separate JWT secret for admin sessions — isolates admin auth from customer auth
# Generate: openssl rand -hex 64

JWT_EXPIRES_IN=7d
# Customer JWT expiry — 7 days (refresh on activity)

ADMIN_JWT_EXPIRES_IN=24h
# Admin JWT expiry — shorter for security

# ── SENTRY (ERROR MONITORING) ────────────────────────────────────────
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# Sentry Data Source Name — safe to expose (but also used server-side)
# Get from: https://sentry.io → Project Settings → Client Keys

NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# Same DSN — used for frontend error capture

SENTRY_ORG=your-sentry-org
# Sentry organization slug — for sourcemap uploads in CI/CD

SENTRY_PROJECT=ummati-perfumes
# Sentry project name

SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxx
# Sentry auth token — for uploading source maps during build (CI/CD only)
# Generate: Sentry → Settings → Auth Tokens

# ── NEXT.JS INTERNAL ─────────────────────────────────────────────────
NEXTAUTH_SECRET=replace-with-64-char-random-string
# Used by NextAuth if added in future — generate now to be ready
# Generate: openssl rand -hex 64

NEXTAUTH_URL=https://ummatiperfumes.com
# Must match NEXT_PUBLIC_SITE_URL — required by NextAuth

# ── DEVELOPMENT ONLY ─────────────────────────────────────────────────
# NODE_ENV is set automatically by Next.js (development / production)
# Do NOT set it manually here

# CORS_ORIGIN=http://localhost:3000
# Only needed if you add a standalone API consumer later
